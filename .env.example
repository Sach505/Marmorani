# ============================================
# Marmorani Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control
#
# Environment Scope Legend:
#   [P] = Production only
#   [P,V] = Production + Preview (Vercel)
#   [ALL] = Production, Preview, Development
# ============================================

# --------------------------------------------
# DATABASE (Supabase PostgreSQL)
# --------------------------------------------
# Pooled connection - Use for Prisma queries (serverless compatible)
# Scope: [ALL] - Required for all environments
# Source: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Transaction mode
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection - Use for Prisma migrations only
# Scope: [ALL] - Required for migrations and schema push
# Source: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session mode
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --------------------------------------------
# SUPABASE
# --------------------------------------------
# Supabase project URL (public, safe to expose)
# Scope: [ALL]
# Source: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"

# Supabase anonymous key (public, safe to expose - has row-level security)
# Scope: [ALL]
# Source: Supabase Dashboard -> Project Settings -> API -> anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase service role key (SECRET - bypasses RLS, admin access)
# Scope: [P] - Production only for security
# Source: Supabase Dashboard -> Project Settings -> API -> service_role key
# WARNING: Never expose this key to the client
SUPABASE_SERVICE_ROLE_KEY=""

# --------------------------------------------
# STRIPE
# --------------------------------------------
# Stripe secret key (SECRET - server-side only)
# Scope: [P,V]
# Source: Stripe Dashboard -> Developers -> API keys -> Secret key
# Use test mode keys (sk_test_...) for development/preview
STRIPE_SECRET_KEY="sk_test_..."

# Stripe publishable key (public, safe to expose)
# Scope: [ALL]
# Source: Stripe Dashboard -> Developers -> API keys -> Publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe webhook signing secret (SECRET - server-side only)
# Scope: [P] - Production only (set up in Epic 5)
# Source: Stripe Dashboard -> Developers -> Webhooks -> Signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."

# --------------------------------------------
# RESEND (Email Service)
# --------------------------------------------
# Resend API key (SECRET - server-side only)
# Scope: [P,V]
# Source: Resend Dashboard -> API Keys
RESEND_API_KEY="re_..."

# --------------------------------------------
# APP CONFIGURATION
# --------------------------------------------
# Application base URL
# Scope: [ALL]
# Production: Your domain (e.g., https://marmorani.com)
# Preview: Use VERCEL_URL automatically or leave as placeholder
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
